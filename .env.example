NODE_ENV=development
DATABASE_URL=postgresql://reward:replace-me@127.0.0.1:55432/reward_platform
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# Optional comma-separated browser origins for trusted previews or tunnels.
APP_TRUSTED_ORIGINS=
API_PORT=4000
# Set on the frontend host only after the backend is deployed.
API_ORIGIN=http://127.0.0.1:4000
MAIL_MODE=file
MAIL_OUTBOX=.local/mail
TASK_PROOF_DIR=.local/task-proofs
MAIL_FROM=Rewardly <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
JOB_WORKER_ENABLED=true
JOB_POLL_MS=2000
# Required to read /api/v1/metrics. Use a random value of at least 24 characters.
HEALTH_TOKEN=
